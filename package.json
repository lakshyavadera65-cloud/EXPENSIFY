{
  "name": "expensify-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "EXPENSIFY All-In-One Full-Stack Application",
  "scripts": {
    "dev": "./start.sh",
    "dev:backend": "cd backend && mvn spring-boot:run -Dspring-boot.run.profiles=dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:backend": "cd backend && mvn clean package -DskipTests",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:backend && npm run build:frontend"
  }
}
